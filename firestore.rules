rules_version = '2';

// 학생·교사의 인터넷 창이 Firestore에 직접 읽고 쓰는 것은 모두 막습니다.
// 문제지와 풀이 결과는 앱 서버(Next.js의 /api)가 서버용 열쇠로만 다루며,
// 서버가 교사 계정·공개 여부를 확인합니다. 서버용 열쇠는 이 규칙의 영향을 받지 않습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
